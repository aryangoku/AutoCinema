{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autocinema.dev/schemas/world/1.0.0",
  "title": "AutoCinema WorldIR v1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "world_id",
    "seed",
    "title",
    "logline",
    "genre",
    "template",
    "truth",
    "start_location",
    "locations",
    "doors",
    "characters",
    "items",
    "facts",
    "actions",
    "endings",
    "asset_manifest"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "world_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "logline": {
      "type": "string",
      "minLength": 1
    },
    "genre": {
      "const": "mystery"
    },
    "template": {
      "enum": [
        "coastal_mystery",
        "manor_mystery",
        "small_town_mystery"
      ]
    },
    "truth": {
      "$ref": "#/$defs/Truth"
    },
    "start_location": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "locations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Location"
      }
    },
    "doors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Door"
      }
    },
    "characters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Character"
      }
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Item"
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Fact"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Action"
      }
    },
    "endings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Ending"
      }
    },
    "asset_manifest": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Asset"
      }
    }
  },
  "$defs": {
    "Truth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "antagonist_or_secret",
        "timeline",
        "secret_fact_ids"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "antagonist_or_secret": {
          "type": "string",
          "minLength": 1
        },
        "timeline": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "secret_fact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "uniqueItems": true
        }
      }
    },
    "Exit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "to_location_id",
        "door_id"
      ],
      "properties": {
        "to_location_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "door_id": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "prefab_id",
        "description",
        "exits"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "prefab_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "exits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Exit"
          }
        }
      }
    },
    "Door": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "location_a",
        "location_b",
        "initial_state"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "location_a": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "location_b": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "initial_state": {
          "enum": [
            "locked",
            "closed",
            "open"
          ]
        }
      }
    },
    "Character": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "prefab_id",
        "start_location",
        "public_role",
        "private_goal",
        "initial_known_fact_ids",
        "secret_fact_ids",
        "dialogue_fallback"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "prefab_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "start_location": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "public_role": {
          "type": "string",
          "minLength": 1
        },
        "private_goal": {
          "type": "string",
          "minLength": 1
        },
        "initial_known_fact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "uniqueItems": true
        },
        "secret_fact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "uniqueItems": true
        },
        "dialogue_fallback": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "prefab_id",
        "initial_location",
        "portable",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "prefab_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "initial_location": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "portable": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "hidden_until_discovered"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "hidden_until_discovered": {
          "type": "boolean"
        }
      }
    },
    "Predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "ref"
      ],
      "properties": {
        "type": {
          "enum": [
            "has_item",
            "knows_fact",
            "at_location",
            "flag_true",
            "door_unlocked"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      }
    },
    "Effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "ref"
      ],
      "properties": {
        "type": {
          "enum": [
            "learn_fact",
            "take_item",
            "unlock_door",
            "set_flag",
            "trigger_ending"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      }
    },
    "Action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "verb",
        "location_id",
        "target_id",
        "preconditions",
        "effects"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "verb": {
          "enum": [
            "inspect",
            "take",
            "unlock",
            "present",
            "finish",
            "leave",
            "talk",
            "read"
          ]
        },
        "location_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "target_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "preconditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Predicate"
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Effect"
          }
        }
      }
    },
    "Ending": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "summary",
        "requires"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "requires": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Predicate"
          }
        }
      }
    },
    "Asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "kind"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "kind": {
          "enum": [
            "location",
            "npc",
            "prop"
          ]
        }
      }
    }
  }
}
