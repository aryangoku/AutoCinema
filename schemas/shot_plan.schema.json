{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "trigger_event": {
      "enum": [
        "LOCATION_ENTERED",
        "EVIDENCE_DISCOVERED",
        "NPC_CONFRONTED",
        "QUEST_TURNING_POINT",
        "ENDING_TRIGGERED"
      ]
    },
    "location_id": {
      "type": "string",
      "minLength": 1
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "shot": {
            "enum": [
              "ESTABLISHING_WIDE",
              "MEDIUM",
              "CLOSE_UP",
              "INSERT",
              "OVER_SHOULDER",
              "TWO_SHOT",
              "TRACKING",
              "REACTION"
            ]
          },
          "anchor": {
            "type": "string",
            "minLength": 1
          },
          "duration_s": {
            "type": "number",
            "minimum": 0.2,
            "maximum": 10
          }
        },
        "required": [
          "shot",
          "anchor",
          "duration_s"
        ]
      }
    },
    "audio_cue": {
      "type": "string",
      "minLength": 1
    },
    "subtitle_id": {
      "type": "string",
      "minLength": 1
    },
    "skip_allowed": {
      "const": true
    }
  },
  "required": [
    "plan_id",
    "trigger_event",
    "location_id",
    "shots",
    "audio_cue",
    "subtitle_id",
    "skip_allowed"
  ],
  "title": "Cinematic Director ShotPlan v1"
}
